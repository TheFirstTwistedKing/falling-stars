# 디스코드 개발자 포털 > Bot > Reset Token 으로 받은 토큰
DISCORD_TOKEN=

# 테스트 서버 ID. 넣으면 명령이 그 서버에 즉시 반영됨 (비우면 전역 등록, 최대 1시간)
DEV_GUILD_ID=

# 이 이름의 역할을 가진 사람은 GM 명령을 쓸 수 있음
GM_ROLE_NAME=GM

# true면 세션 중 일반 채팅도 기록 (개발자 포털에서 Message Content Intent를 켜야 함)
LOG_CHAT=false

# 저장 위치 (기본값 그대로 써도 됨)
# DB_PATH=data/falling_stars.db
# LORE_PATH=data/lore.json
